cabal-version:      2.4
name:               markov
version:            0.1.0.0
synopsis:           Cadeia de Markov de clima: simulacao e analise de probabilidades
build-type:         Simple

executable markov
    main-is:          Main.hs
    hs-source-dirs:   app, src
    other-modules:    Markov
    build-depends:    base >=4 && <5, random >=1.2
    default-language: Haskell2010
    ghc-options:      -Wall
